<lint>

    <!--
        The app uses Credential Manager for Google sign-in and saved password credentials, which
        need no Digital Asset Links file. Lint cannot tell that apart from passkey support, which
        does.

        Passkeys require a `<meta-data android:name="asset_statements">` entry pointing at an
        assetlinks.json hosted on your own domain, so a template cannot supply one. If you add
        passkey sign-in, delete this suppression and follow:
        https://developer.android.com/identity/sign-in/credential-manager#add-support-dal
    -->
    <issue id="CredManMissingDal" severity="ignore" />

</lint>
